{
  "name": "@openducktor/build-tools",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./static-site": "./src/static-site.ts"
