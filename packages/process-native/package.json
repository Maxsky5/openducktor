{
  "name": "@openducktor/process-native",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./scripts/build-native.ts"
  },
  "scripts": {
    "build": "bun run scripts/build-native.ts",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --only-failures --timeout 5000",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts",
    "lint:rust": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.2"
  }
}
