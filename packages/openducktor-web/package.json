{
  "name": "@openducktor/web",
  "version": "0.6.0-beta.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxsky5/openducktor.git"
  },
  "bin": {
    "openducktor-web": "dist/cli.js",
    "web": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "start": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "build:web-shell": "bunx vite build --outDir dist/web-shell --emptyOutDir",
    "build:cli": "bun run scripts/build-cli.ts",
    "build:mcp": "bun run scripts/build-mcp.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 1000",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts",
    "publish:dry-run": "npm publish --dry-run --access public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.238",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@openducktor/build-tools": "workspace:*",
    "@openducktor/contracts": "workspace:*",
    "@openducktor/frontend": "workspace:*",
    "@openducktor/host": "workspace:*",
    "@openducktor/host-client": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.1.0",
    "bun-types": "^1.4.0",
    "effect": "^3.22.0",
    "vite": "^8.2.2"
  }
}
