{
  "name": "@openducktor/web",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxsky5/openducktor.git"
  },
  "bin": {
    "openducktor-web": "dist/cli.js",
    "web": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build:cli && bun run build:mcp && bun run scripts/dev.ts",
    "dev:client": "vite --mode standalone",
    "start": "node dist/cli.js",
    "build": "bun run scripts/build.ts",
    "build:web-shell": "bunx vite build --outDir dist/web-shell --emptyOutDir",
    "build:client": "bunx vite build --mode standalone --outDir dist/client --emptyOutDir",
    "build:cli": "bun run scripts/build-cli.ts",
    "build:mcp": "bun run scripts/build-mcp.ts",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --preload ../../scripts/bun-test-preload.ts --timeout 1000",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts",
    "publish:dry-run": "npm publish --dry-run --access public",
    "worker:check": "cmp client/_headers dist/client/_headers && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.json"
  },
  "dependencies": {
    "@azure/msal-node-extensions": "^5.5.2",
    "@ff-labs/fff-node": "0.11.0",
    "node-pty": "1.2.0-beta.15",
    "playwright-core": "1.64.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@openducktor/build-tools": "workspace:*",
    "@openducktor/contracts": "workspace:*",
    "@openducktor/frontend": "workspace:*",
    "@openducktor/frontend-core": "workspace:*",
    "@openducktor/host": "workspace:*",
    "@openducktor/host-client": "workspace:*",
    "@openducktor/remote-host": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.2",
    "effect": "4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2",
    "vite": "^8.3.4",
    "wrangler": "4.149.0",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "trustedDependencies": [
    "keytar"
  ]
}
