{
  "name": "@openducktor/workflows",
  "version": "1.2.1",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./test-support/index.ts"
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.test.json",
    "test": "bun test --pass-with-no-tests --timeout 1000",
    "lint": "oxlint -c ../../.oxlintrc.json src"
  },
  "dependencies": {
    "@openducktor/contracts": "workspace:*",
    "zod": "^4.6.7"
  }
}
