{
  "name": "@openducktor/host",
  "version": "1.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./claude-transcript-worker": "./src/adapters/claude/claude-transcript-worker.ts",
    "./generated-image-worker": "./src/adapters/attachments/generated-image-worker.ts",
    "./node-pty": "./src/adapters/node/pty-process-adapter.ts",
    "./chrome-for-testing": "./src/adapters/browser/chrome-for-testing/chrome-for-testing-engine.ts"
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.task-store.config.ts",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --preload ../../scripts/bun-test-preload.ts --pass-with-no-tests --timeout 5000 --parallel=2 --no-isolate",
    "test:browser-conformance": "ODT_CHROME_FOR_TESTING_CONFIG_ROOT=../../node_modules/.cache/openducktor-chrome-for-testing bun test --timeout 120000 src/adapters/browser/chrome-for-testing/chrome-for-testing-engine.live.test.ts",
    "lint": "oxlint -c ../../.oxlintrc.json src drizzle.task-store.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@azure/msal-node": "^7.1.0",
    "@azure/msal-node-extensions": "^5.5.2",
    "@ff-labs/fff-node": "0.11.0",
    "@openducktor/adapters-codex-app-server": "workspace:*",
    "@openducktor/adapters-opencode-sdk": "workspace:*",
    "@openducktor/contracts": "workspace:*",
    "@openducktor/core": "workspace:*",
    "@openducktor/path-support": "workspace:*",
    "@openducktor/runtime-orchestration": "workspace:*",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.5",
    "file-type": "^22.2.0",
    "playwright-core": "1.64.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "stream-chain": "4.2.6",
    "stream-json": "3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bippy": "0.7.3",
    "bun-types": "^1.4.2",
    "drizzle-kit": "0.31.11",
    "node-pty": "1.2.0-beta.15"
  }
}
