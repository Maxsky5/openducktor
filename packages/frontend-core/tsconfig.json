{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "lib": ["ES2023", "ES2024.Promise"],
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "src/test-support",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-*.ts",
    "src/**/*.test-*.tsx",
    "src/**/*-test-*.ts",
    "src/**/test-utils.ts"
  ]
}
