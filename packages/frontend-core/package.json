{
  "name": "@openducktor/frontend-core",
  "version": "1.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.test.json && bun check -p expo-compat/tsconfig.json",
    "test": "bun test --parallel --pass-with-no-tests --timeout 1000",
    "lint": "oxlint -c ../../.oxlintrc.json src expo-compat"
  },
  "dependencies": {
    "@openducktor/contracts": "workspace:*",
    "@openducktor/core": "workspace:*",
    "@openducktor/host-client": "workspace:*",
    "@openducktor/path-support": "workspace:*",
    "@openducktor/workflows": "workspace:*",
    "@tanstack/react-query": "^5.104.4",
    "react": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@openducktor/adapters-codex-app-server": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.2",
    "react-dom": "^19.3.1"
  }
}
