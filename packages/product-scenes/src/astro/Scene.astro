---
// A product scene for an Astro page. The build renders the React view of the scene to static HTML
// with react-dom/server, so the page loads no React. The script mounts the timeline of each scene
// on the page.
import { MAC_KEYS, type KeyLabels } from "../replicas/keys";
import type { SceneName, SceneOptionsProp } from "../registry";
import { renderView } from "./render";

type Props = {
  [Name in SceneName]: {
    name: Name;
    /** The keys that the scene shows. The default is the macOS keys. */
    keys?: KeyLabels;
  } & SceneOptionsProp<Name>;
}[SceneName];
const { name, keys = MAC_KEYS, options }: Props = Astro.props;
const html = renderView(name, keys, options ?? {});
---

<Fragment set:html={html} />
<script>
  import { mountPageScenes } from "./mount-page";
  mountPageScenes();
</script>
