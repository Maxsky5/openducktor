{
  "name": "@openducktor/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "OpenDucktor mobile app for iOS and Android",
  "main": "index.ts",
  "scripts": {
    "start": "bun run build:page && expo start",
    "ios": "bun run build:page && expo run:ios",
    "android": "bun run build:page && expo run:android",
    "native": "expo prebuild --clean",
    "build": "bun run build:page && expo export --platform ios --platform android --output-dir dist",
    "build:page": "bun run scripts/build-isolated-page.ts",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.test.json",
    "test": "bun test --parallel --pass-with-no-tests --timeout 1000",
    "lint": "oxlint -c ../../.oxlintrc.json src modules plugins scripts index.ts app.config.ts"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@openducktor/contracts": "workspace:*",
    "@openducktor/core": "workspace:*",
    "@openducktor/frontend-core": "workspace:*",
    "@openducktor/host-client": "workspace:*",
    "@react-native/normalize-colors": "0.88.0",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-system-ui": "~58.0.6",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.5.3",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "refractor": "^5.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@xterm/xterm": "^6.0.0",
    "babel-preset-expo": "~58.0.17",
    "bun-types": "^1.4.2",
    "lucide-static": "1.59.0",
    "mermaid": "^12.2.0",
    "micromark": "^4.0.3",
    "react-dom": "19.3.1"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
