{
  "name": "@openducktor/electron",
  "version": "1.0.1",
  "private": true,
  "description": "OpenDucktor desktop application",
  "homepage": "https://github.com/Maxsky5/openducktor",
  "author": {
    "name": "Maxsky5",
    "email": "maxsky5@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:main": "bun build --target=node --minify --keep-names --external electron --external node-pty --external playwright-core --external @ff-labs/fff-node --external @azure/msal-node-extensions --splitting --outdir dist --entry-naming '[name].[ext]' --chunk-naming 'chunks/[name]-[hash].[ext]' src/main/main.ts src/main/generated-image-worker.ts src/main/claude-transcript-worker.ts",
    "build:preload": "bun build --target=node --minify --keep-names --format=cjs --external electron --outfile dist/preload.cjs src/preload/preload.ts",
    "build:renderer": "vite build --outDir dist/renderer --emptyOutDir",
    "builder": "electron-builder",
    "dev": "bun run scripts/dev.ts",
    "dev:cdp": "bun run scripts/dev.ts --cdp",
    "dev:electron": "bun run scripts/dev.ts",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "package": "bun run scripts/package-build.ts",
    "release:artifact": "bun run scripts/package-build.ts --stage-release-artifacts",
    "preview": "electron dist/main.js",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --preload ../../scripts/bun-test-preload.ts --pass-with-no-tests --timeout 1000",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts vite.config.ts"
  },
  "dependencies": {
    "@azure/msal-node-extensions": "^5.5.3",
    "@ff-labs/fff-node": "0.11.0",
    "node-pty": "1.2.0-beta.15",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openducktor/build-tools": "workspace:*",
    "@openducktor/contracts": "workspace:*",
    "@openducktor/frontend": "workspace:*",
    "@openducktor/frontend-core": "workspace:*",
    "@openducktor/host": "workspace:*",
    "@openducktor/host-client": "workspace:*",
    "@openducktor/remote-host": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.2",
    "effect": "4.0.6",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "electron-updater": "^6.8.11",
    "mime-types": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "7.8.5",
    "vite": "^8.3.5",
    "ws": "8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "node-mac-permissions": "github:codebytere/node-mac-permissions#b2b0a18e4d21d6926fde1cd84d9124a0b8e6b755"
  },
  "productName": "OpenDucktor"
}
