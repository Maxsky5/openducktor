{
  "name": "@openducktor/electron",
  "version": "0.7.0",
  "private": true,
  "description": "OpenDucktor desktop application",
  "homepage": "https://github.com/Maxsky5/openducktor",
  "author": {
    "name": "Maxsky5",
    "email": "maxsky5@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:main": "bun build --target=node --external electron --external node-pty --external @ff-labs/fff-node --splitting --outdir dist --entry-naming '[name].[ext]' --chunk-naming 'chunks/[name]-[hash].[ext]' src/main/main.ts src/main/generated-image-worker.ts",
    "build:preload": "bun build --target=node --format=cjs --external electron --outfile dist/preload.cjs src/preload/preload.ts",
    "build:renderer": "vite build --outDir dist/renderer --emptyOutDir",
    "builder": "electron-builder",
    "dev": "bun run scripts/dev.ts",
    "dev:cdp": "bun run scripts/dev.ts --cdp",
    "dev:electron": "bun run scripts/dev.ts",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "package": "bun run scripts/package-build.ts",
    "release:artifact": "bun run scripts/package-build.ts --stage-release-artifacts",
    "preview": "electron dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --preload ../../scripts/bun-test-preload.ts --pass-with-no-tests --timeout 1000",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts vite.config.ts"
  },
  "dependencies": {
    "@ff-labs/fff-node": "0.10.6",
    "electron-updater": "^6.8.9",
    "node-pty": "1.2.0-beta.15",
    "semver": "7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@openducktor/build-tools": "workspace:*",
    "@openducktor/contracts": "workspace:*",
    "@openducktor/frontend": "workspace:*",
    "@openducktor/host": "workspace:*",
    "@openducktor/host-client": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.4.2",
    "effect": "^3.22.2",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "node-mac-permissions": "github:codebytere/node-mac-permissions#b2b0a18e4d21d6926fde1cd84d9124a0b8e6b755"
  },
  "productName": "OpenDucktor"
}
