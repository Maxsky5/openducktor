{
  "name": "@openducktor/marketing-website",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "test": "bun test --preload ../../scripts/bun-test-preload.ts --timeout 1000 ./tests",
    "test:browser": "playwright test",
    "format": "prettier --write 'src/**/*.astro'",
    "format:check": "prettier --check 'src/**/*.astro'",
    "lint:css": "stylelint 'src/**/*.css'",
    "worker:dev": "WRANGLER_SEND_METRICS=false wrangler dev --config wrangler.preview.json --local",
    "worker:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.json && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.preview.json"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@lucide/astro": "^1.47.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.0",
    "astro": "^7.3.3",
    "gsap": "^3.15.0",
    "prettier": "^3.8.0",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^6.0.0",
    "wrangler": "4.144.0",
    "zod": "^4.6.5"
  }
}
