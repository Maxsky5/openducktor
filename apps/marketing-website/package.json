{
  "name": "@openducktor/marketing-website",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "test": "bun test --timeout 1000 ./tests",
    "test:browser": "playwright test",
    "format": "prettier --config .prettierrc.json --write 'src/**/*.astro' '../../packages/product-scenes/src/**/*.astro'",
    "format:check": "prettier --config .prettierrc.json --check 'src/**/*.astro' '../../packages/product-scenes/src/**/*.astro'",
    "worker:dev": "WRANGLER_SEND_METRICS=false wrangler dev --config wrangler.preview.json --local",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.json",
    "worker:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.json && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.preview.json"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@lucide/astro": "^1.72.0",
    "@openducktor/build-tools": "workspace:*",
    "@openducktor/product-scenes": "workspace:*",
    "@openducktor/theme": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.0",
    "wrangler": "4.158.0",
    "zod": "^4.6.7"
  }
}
