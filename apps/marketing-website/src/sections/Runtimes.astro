---
import Scene from "@openducktor/product-scenes/astro";
import IconItem from "../ui/IconItem.astro";
import IconList from "../ui/IconList.astro";
import ProductFigure from "../ui/ProductFigure.astro";
import RuntimeIcon from "../ui/RuntimeIcon.astro";
import SectionHead from "../ui/SectionHead.astro";
import Split from "./Split.astro";

const runtimes = [
  {
    kind: "opencode" as const,
    name: "OpenCode",
    text: "Choose an agent profile, and a model from the providers that you set up in OpenCode. Add permission rules for each role.",
  },
  {
    kind: "codex" as const,
    name: "Codex",
    text: "Set the sandbox mode, the approval prompts, and the network access of commands. Each role can use other values.",
  },
  {
    kind: "claude" as const,
    name: "Claude Code",
    text: "OpenDucktor uses your Claude Code installation and its sign-in. Set the permission mode, the Bash sandbox, and the Allow, Ask, and Deny rules.",
  },
  {
    kind: "antigravity" as const,
    name: "Antigravity",
    text: "Turn on the Google Antigravity CLI in Settings. Choose its session mode for each role: Default, Accept edits, Auto, or Bypass permissions.",
  },
];
---

<section id="runtimes" class="section runtimes" aria-labelledby="runtimes-title">
  <Split>
    <Fragment slot="copy">
      <SectionHead eyebrow="Runtimes" id="runtimes-title">
        <Fragment slot="title">Use the coding agent that you already have.</Fragment>
        <p>
          OpenDucktor includes no model. It starts OpenCode, Codex, Claude Code, or Antigravity on
          your computer. In each repository, you choose a runtime, a model, and an effort for each
          role.
        </p>
      </SectionHead>
      <IconList>
        {
          runtimes.map((runtime) => (
            <IconItem title={runtime.name}>
              <RuntimeIcon slot="icon" kind={runtime.kind} />
              {runtime.text}
            </IconItem>
          ))
        }
      </IconList>
    </Fragment>
    <ProductFigure caption={["Settings", "Repositories", "Agents"]}>
      <Scene name="runtimes" />
    </ProductFigure>
  </Split>
</section>
