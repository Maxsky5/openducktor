---
import Scene from "@openducktor/product-scenes/astro";
import { release } from "../content/release";
import ProductFigure from "../ui/ProductFigure.astro";
import SectionHead from "../ui/SectionHead.astro";
import "./Palette.css";
---

<section id="palette" class="section palette" aria-labelledby="palette-title">
  <SectionHead eyebrow="Command palette" id="palette-title" class="wrap">
    <Fragment slot="title">Press ⌘K. Run OpenDucktor from the keyboard.</Fragment>
    <p>
      Find any task or session in all your workspaces. Start its next step, or answer its agent,
      without a click.
    </p>
  </SectionHead>
  <div class="wrap-wide palette-figure">
    <ProductFigure caption={["Kanban Board", "Command palette"]}>
      <Scene name="palette" options={{ version: release.version }} />
    </ProductFigure>
  </div>
</section>
