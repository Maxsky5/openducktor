---
// The lanes keep the order of the product. Backlog sorts by priority, then puts the newest task
// first. The other lanes put waiting sessions first, then running sessions, then older activity.
// The sidebar lists the sessions of all workspaces in the groups of the read model.
import AppWindow from "../../replica/shell/AppWindow.astro";
import Board from "../../replica/board/Board.astro";
import BoardHead from "../../replica/board/BoardHead.astro";
import CardActions from "../../replica/board/CardActions.astro";
import type { BoardData } from "../../replica/board/model";
import Pointer from "../../replica/shell/Pointer.astro";
import SessionPreview from "../../replica/shell/SessionPreview.astro";
import PrBadge from "../../replica/board/PrBadge.astro";
import TaskCard from "../../replica/board/TaskCard.astro";
import Toast from "../../replica/shell/Toast.astro";
import { CARDS } from "../../sample/board";
import { HERO_NAV } from "./sessions";
import { CARD_ACTIONS, type HeroTemplate, PREVIEW, TOASTS } from "./templates";
import "./HeroView.css";
import Scene from "../Scene.astro";
import ToastStack from "../../replica/shell/ToastStack.astro";

const board: BoardData = {
  open: [CARDS.sync, CARDS.export],
  spec_ready: [CARDS.titles],
  in_progress: [CARDS.empty, CARDS.shortcut],
  ai_review: [CARDS.focus],
  human_review: [CARDS.typing],
};
---

<Scene
  name="hero"
  class="wrap-wide"
  alt="The OpenDucktor Kanban board and the session sidebar of all workspaces. Agents plan, build, and review tasks in separate lanes, and each session moves between Running and Recent in the sidebar. A merged pull request closes a task. Then a Builder asks a question, and its session moves to Needs you. The visitor points at the session in the sidebar, and its preview opens with the question. The visitor answers in the preview, and the session goes back to Running."
>
  <AppWindow chrome={{ sidebar: "full", nav: HERO_NAV, kanban: true }} class="hero-window">
    <BoardHead />
    <Board board={board} />
    <ToastStack />
    <Pointer slot="overlay" />
  </AppWindow>
  <Fragment slot="templates">
    {
      Object.entries(CARD_ACTIONS).map(([name, actions]) => (
        <template data-tpl={name}>
          <CardActions {...actions} />
        </template>
      ))
    }
    <template data-tpl={"merged" satisfies HeroTemplate}><PrBadge number={41} merged /></template>
    <template data-tpl={"new-task" satisfies HeroTemplate}
      ><TaskCard name="pin" task="w1j5" action="Start Spec" /></template
    >
    <template data-tpl={"preview" satisfies HeroTemplate}><SessionPreview {...PREVIEW} /></template>
    {
      Object.entries(TOASTS).map(([name, toast]) => (
        <template data-tpl={name}>
          <Toast {...toast} />
        </template>
      ))
    }
  </Fragment>
</Scene>
<script>
  import { mountHero } from "./scene";
  mountHero();
</script>
