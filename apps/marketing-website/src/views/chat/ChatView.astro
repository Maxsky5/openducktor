---
// A workspace chat on the session page: the top bar of workspace-session-header.tsx, and the agent
// chat surface with its composer, slash menu, and task tools. The right panel is hidden. The
// templates hold the task details of a new task, the start dialog of its Builder, and the
// notification of the start. Sources: packages/frontend/src/pages/workspace-sessions and
// packages/frontend/src/components/features/agents/agent-chat.
import { Archive, Bot, ChevronDown, ChevronRight, Folder, Terminal } from "@lucide/astro";
import AppWindow from "../../replica/shell/AppWindow.astro";
import Pointer from "../../replica/shell/Pointer.astro";
import Toast from "../../replica/shell/Toast.astro";
import ToastStack from "../../replica/shell/ToastStack.astro";
import StartDialog from "../../replica/studio/StartDialog.astro";
import TaskSheet from "../../replica/tasks/TaskSheet.astro";
import AgentText from "../../replica/transcript/AgentText.astro";
import ToolRow from "../../replica/transcript/ToolRow.astro";
import UserMessage from "../../replica/transcript/UserMessage.astro";
import TaskResult from "../../replica/transcript/TaskResult.astro";
import Thread from "../../replica/transcript/Thread.astro";
import ChatColumn from "../../replica/studio/ChatColumn.astro";
import Composer from "../../replica/studio/Composer.astro";
import OpenInMenu from "../../replica/studio/OpenInMenu.astro";
import PanelToggles from "../../replica/studio/PanelToggles.astro";
import RepoActions from "../../replica/studio/RepoActions.astro";
import SessionHeader from "../../replica/studio/SessionHeader.astro";
import {
  CHAT,
  CHAT_SESSION,
  COMMANDS,
  CREATED_TASKS,
  EXISTING,
  MENU_TASK,
  MESSAGE,
  SEARCH,
} from "../../sample/chat";
import { NAV_SESSIONS } from "../../sample/nav";
import { signature } from "../../sample/sessions";
import { BUILDER_SESSION } from "../../sample/studio";
import { CHAT_ENTRY, studioNav } from "../../sample/studio-nav";
import { taskId } from "../../sample/workspace";
import { OPEN_IN_TERMINAL } from "../../sample/worktree";
import "./ChatView.css";
import Scene from "../Scene.astro";
import { flag } from "../../replica/flag";
import { type ChatTemplate, STARTED } from "./templates";

/**
 * The last frame: the turn ended, and the chat settled at the top of Recent. The Builder of the
 * new task runs at the top of Running.
 */
const nav = [
  NAV_SESSIONS["menu-build"],
  ...studioNav({ ...CHAT_ENTRY, time: "now", selected: true }),
];
---

<Scene
  name="chat"
  alt="A workspace chat with the Product planner role on Claude Code. The visitor types /tasks- and picks the reusable prompt /tasks-from-request, then adds the request Export notebooks to Markdown and PDF. The agent searches the tasks for export and finds the Markdown export task. Then it creates the two tasks that are missing: a PDF export and an Export item in the notebook menu. The visitor opens the menu task from its card, and its details slide in over the chat. The visitor clicks Start Builder and runs the Builder in the background. The chat stays on screen, and the new Builder session shows in the Running group of the sidebar."
>
  <AppWindow
    chrome={{ sidebar: "collapsed", nav: { scope: "current", entries: nav } }}
    class="chat-window"
    data-runtime={CHAT_SESSION.runtime}
  >
    <SessionHeader>
      <span class="sh-name" slot="title"><span>{CHAT.title}</span></span>
      <RepoActions />
      <span class="sh-icon"><Bot class="i14" /></span>
      <span class="sh-icon"><Folder /></span>
      <span class="sh-split"
        ><span class="sh-split-main"><Archive /><span>Archive</span></span><span
          class="sh-split-menu"><ChevronDown /></span
        ></span
      >
      <OpenInMenu tool={OPEN_IN_TERMINAL} appIcon />
      <PanelToggles right={false} />
    </SessionHeader>
    <ChatColumn class="ch-column">
      <Thread>
        <UserMessage time="10:24:12 AM" row="message">{MESSAGE}</UserMessage>
        <ToolRow
          kind="tool"
          name="search_tasks"
          args={SEARCH.done}
          duration="212ms"
          time="10:24:15 AM"
          row="search"
        />
        <AgentText row="plan">
          <p>
            <code>{EXISTING}</code> already covers the Markdown export. I will create the two tasks that
            are missing.
          </p>
        </AgentText>
        {
          CREATED_TASKS.map((task) => (
            <ToolRow
              kind="tool"
              name="create_task"
              args={task.title}
              duration="64ms"
              time={task.time}
              row={`create-${task.id}`}
            >
              <TaskResult task={task} />
            </ToolRow>
          ))
        }
        <AgentText signature={signature(CHAT_SESSION)} worked="14s" row="final">
          <p>
            The two new tasks are in Backlog. The PDF export is a feature, so it starts with a spec.{
              " "
            }
            <code>{taskId(MENU_TASK.id)}</code> is a task, so its Builder can start now.
          </p>
        </AgentText>
      </Thread>
      <Composer session={CHAT_SESSION}>
        <div class="ch-slash" slot="menu" data-slash>
          {
            COMMANDS.map((command, index) => (
              <span class="ch-command" data-active={flag(index === 0)}>
                <span class="ch-command-icon">
                  <Terminal class="i14" />
                </span>
                <span class="ch-command-text">
                  <span class="ch-command-name">
                    <span>/{command.trigger}</span>
                    <small>custom</small>
                  </span>
                  <span class="ch-command-desc">{command.description}</span>
                </span>
                <ChevronRight class="ch-command-chevron" />
              </span>
            ))
          }
        </div>
        <span class="ch-draft"
          ><span class="ch-chip" hidden data-chip>/{COMMANDS[0]?.trigger}</span><span
            class="typed"
            data-typed></span></span
        >
      </Composer>
    </ChatColumn>
    <ToastStack />
    <Pointer slot="overlay" />
  </AppWindow>
  <Fragment slot="templates">
    <template data-tpl={"sheet" satisfies ChatTemplate}><TaskSheet task={MENU_TASK} /></template>
    <template data-tpl={"builder-dialog" satisfies ChatTemplate}
      ><StartDialog
        role="Builder"
        description="Start a fresh session for Start Implementation."
        session={BUILDER_SESSION}
        target="origin/main"
        background
      /></template
    >
    <template data-tpl={"toast-started" satisfies ChatTemplate}><Toast {...STARTED} /></template>
  </Fragment>
</Scene>
<script>
  import { mountChat } from "./scene";
  mountChat();
</script>
