---
// The implementation plan of the story task. The Planner works as an architect: one diagram of the
// changed modules, a table of their changes, the boundary contract, and the requirement coverage.
// The Builder owns the files and the tests. Source: system.role.planner.base in
// packages/core/src/services/agent-system-prompts.ts.
import DocHeading from "../../../replica/studio/DocHeading.astro";
import FlowDiagram from "../../../replica/studio/FlowDiagram.astro";
import Prose from "../../../replica/studio/Prose.astro";

const contract = "export function useSearchShortcut(openSearch: () => void): void;";
---

<Prose>
  <DocHeading level={1}>Implementation plan</DocHeading>
  <DocHeading level={2}>Approach</DocHeading>
  <p>
    One keyboard hook that the app shell mounts once opens the existing search dialog, so search
    itself does not change.
  </p>
  <FlowDiagram />
  <DocHeading level={2}>Design</DocHeading>
  <table>
    <thead>
      <tr><th>Module</th><th>Change</th><th>Reason</th></tr>
    </thead>
    <tbody>
      <tr><td><code>search</code></td><td>New shortcut hook</td><td>One owner of the key</td></tr>
      <tr><td><code>app</code></td><td>Shell mounts the hook</td><td>Works on every page</td></tr>
      <tr><td><code>search</code></td><td>Dialog restores focus</td><td>Close requirement</td></tr>
    </tbody>
  </table>
  <DocHeading level={3}>Search shortcut</DocHeading>
  <ul>
    <li>Matches <code>metaKey</code> on macOS and <code>ctrlKey</code> elsewhere.</li>
    <li>Returns early in text fields and while a modal dialog is open.</li>
  </ul>
  <pre><code>{contract}</code></pre>
  <DocHeading level={2}>Requirement coverage</DocHeading>
  <table>
    <thead>
      <tr><th>Requirement</th><th>Design</th></tr>
    </thead>
    <tbody>
      <tr><td>Open search</td><td>The hook calls <code>openSearch</code></td></tr>
      <tr><td>Text fields</td><td>The hook checks the event target</td></tr>
      <tr><td>Close</td><td>The dialog restores focus</td></tr>
    </tbody>
  </table>
  <DocHeading level={2}>Risks and constraints</DocHeading>
  <ul>
    <li>
      <code>src/app/keymap.ts</code> binds <code>Cmd+Shift+K</code>, so the hook ignores{" "}
      <code>Shift</code>.
    </li>
  </ul>
</Prose>
