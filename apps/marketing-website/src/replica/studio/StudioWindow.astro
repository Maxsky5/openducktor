---
// The session page of a task: the top bar over the full width, the workflow rail above the chat
// column, the right panel with its tabs, and an optional bottom panel. Sources:
// pages/agents/shell/agents-page-layout.tsx, agent-studio-header.tsx, and
// features/session-panels in packages/frontend/src. The sidebar is collapsed, so the session has
// room, and it groups the sessions by task. The History icon of the product is RotateCcwClock in
// Lucide 1.
import { ChevronDown, Copy, RotateCcwClock, SquareArrowOutUpRight, Zap } from "@lucide/astro";
import AppWindow from "../shell/AppWindow.astro";
import Pointer from "../shell/Pointer.astro";
import Thread from "../transcript/Thread.astro";
import ChatColumn from "./ChatColumn.astro";
import Composer from "./Composer.astro";
import OpenInMenu from "./OpenInMenu.astro";
import PanelTabs from "./PanelTabs.astro";
import PanelToggles from "./PanelToggles.astro";
import RepoActions from "./RepoActions.astro";
import SessionHeader from "./SessionHeader.astro";
import WorkflowRail from "./WorkflowRail.astro";
import ResizeHandle from "../ui/ResizeHandle.astro";
import { flag } from "../flag";
import type { StudioFrame } from "../../sample/studio";
import { TASKS } from "../../sample/tasks";
import { OPEN_IN_TERMINAL } from "../../sample/worktree";
import { taskId } from "../../sample/workspace";
import { WAITING } from "../vocabulary";
import "./StudioWindow.css";

interface Props {
  /** The window state of the frame that the markup holds. */
  frame: StudioFrame;
  /** The bottom panel shows, with the terminals in the bottom slot. */
  bottom?: boolean;
  class?: string;
}
const { frame, bottom = false, class: className } = Astro.props;
---

<AppWindow
  chrome={{ sidebar: "collapsed", nav: { scope: "current", entries: frame.nav } }}
  class:list={["studio", className]}
  data-studio
  data-runtime={frame.session.runtime}
  data-focus={frame.focus}
  data-panel-size={frame.panelSize}
>
  <SessionHeader>
    <Fragment slot="title">
      <span class="sh-name"
        ><span>{TASKS.k3x9.title}</span><SquareArrowOutUpRight class="i12" /></span
      >
      <span class="sh-id"><code>{taskId("k3x9")}</code><span><Copy class="i12" /></span></span>
    </Fragment>
    <slot name="pr" />
    <RepoActions />
    <span class="sh-icon sh-hide-narrow"><RotateCcwClock /></span>
    <span class="sh-split" data-disabled={flag(frame.actionDisabled)} data-split>
      <span class="sh-split-main" data-quick-action
        ><Zap /><span data-action>{frame.action}</span></span
      ><span class="sh-split-menu"><ChevronDown /></span>
    </span>
    <slot name="openin"><OpenInMenu tool={OPEN_IN_TERMINAL} appIcon /></slot>
    <PanelToggles bottom={bottom} />
  </SessionHeader>
  <div class="st-area">
    <div class="st-body">
      <div class="st-main">
        <WorkflowRail tones={frame.tones} selected={frame.selected} />
        <ChatColumn>
          <Thread><slot /></Thread>
          <div class="st-stack" data-stack></div>
          <Composer session={frame.session} commentCount>
            <span class="when-waiting" data-waiting>{WAITING.question}</span>
          </Composer>
        </ChatColumn>
      </div>
      <ResizeHandle orientation="vertical" class="st-handle" />
      <div class="st-panel">
        <PanelTabs frame={frame} />
        <div class="st-panel-body" data-panel-body data-active-panel={frame.panel}>
          <slot name="panel" />
        </div>
      </div>
    </div>
    <slot name="bottom" />
  </div>
  <Fragment slot="overlay"><slot name="overlay" /><Pointer /></Fragment>
</AppWindow>
