---
// The panel toggles of session-view-controls.tsx: the bottom panel and the right panel. An open
// panel shows the close icon, and its toggle is pressed. A scene opens the bottom panel with
// aria-pressed.
import { PanelBottomClose, PanelBottomOpen, PanelRightClose, PanelRightOpen } from "@lucide/astro";
import "./PanelToggles.css";

interface Props {
  bottom?: boolean;
  right?: boolean;
}
const { bottom = false, right = true } = Astro.props;
---

<span
  class="sh-icon pt-toggle pt-bottom"
  aria-pressed={bottom ? "true" : "false"}
  data-toggle="bottom"
  ><PanelBottomOpen class="when-closed" /><PanelBottomClose class="when-open" /></span
><span class="sh-icon pt-toggle" aria-pressed={right ? "true" : "false"}
  ><PanelRightOpen class="when-closed" /><PanelRightClose class="when-open" /></span
>
