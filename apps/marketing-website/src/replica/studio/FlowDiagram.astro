---
// A Mermaid flowchart of a document, as markdown-mermaid.tsx shows it: the default Mermaid theme
// on a white box with a border, in both themes. This copy draws the diagram of the sample plan.
import "./FlowDiagram.css";
---

<div class="flow">
  <svg viewBox="0 0 380 268" aria-hidden="true">
    <path class="flow-edge" d="M95 52C95 80 172 74 172 97"></path>
    <path class="flow-edge" d="M285 52C285 80 208 74 208 97"></path>
    <path class="flow-edge" d="M190 144V189"></path>
    <path class="flow-head" d="M167 97h10l-5 9z"></path>
    <path class="flow-head" d="M203 97h10l-5 9z"></path>
    <path class="flow-head" d="M185 189h10l-5 9z"></path>
    <rect class="flow-label" x="102" y="66" width="56" height="18"></rect>
    <text class="flow-label-text" x="130" y="79">mounts</text>
    <rect class="flow-label" x="222" y="66" width="60" height="18"></rect>
    <text class="flow-label-text" x="252" y="79">keydown</text>
    <rect class="flow-label" x="150" y="161" width="80" height="18"></rect>
    <text class="flow-label-text" x="190" y="174">openSearch</text>
    <rect class="flow-node" x="30" y="14" width="130" height="38"></rect>
    <text class="flow-text" x="95" y="38">AppShell</text>
    <rect class="flow-node" x="220" y="14" width="130" height="38"></rect>
    <text class="flow-text" x="285" y="38">window</text>
    <rect class="flow-node" x="105" y="106" width="170" height="38"></rect>
    <text class="flow-text" x="190" y="130">useSearchShortcut</text>
    <rect class="flow-node" x="120" y="198" width="140" height="38"></rect>
    <text class="flow-text" x="190" y="222">SearchDialog</text>
  </svg>
</div>
