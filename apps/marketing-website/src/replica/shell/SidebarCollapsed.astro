---
// The collapsed sidebar of workspace-sidebar.tsx: the show button in the title bar, the command
// palette, the Kanban link, the New task button, the scope toggle, one icon for each session in
// session-navigation-rail.tsx, and Diagnostics and Settings. The icons sit under the label and
// the count of their group.
import {
  Columns3,
  LayoutGrid,
  PanelLeftOpen,
  Plus,
  Search,
  Settings,
  ShieldCheck,
} from "@lucide/astro";
import { type NavData, navGroupViews } from "./nav";
import NavIcon from "./NavIcon.astro";
import "./NavGroups.css";
import "./SidebarCollapsed.css";

interface Props {
  nav: NavData;
  kanban?: boolean;
}
const { nav, kanban = false } = Astro.props;
const groups = navGroupViews(nav.entries);
---

<div class="sb-collapsed">
  <div class="sbc-title"><span class="sbc-button"><PanelLeftOpen /></span></div>
  <div class="sbc-tools">
    <span class="sbc-button large"><Search /></span>
    <span class="sbc-button large" aria-current={kanban ? "true" : undefined}><Columns3 /></span>
    <span class="sbc-button large primary"><Plus /></span>
  </div>
  <div class="sbc-scope">
    <span class="sbc-button" aria-pressed={nav.scope === "all" ? "true" : "false"}
      ><LayoutGrid /></span
    >
  </div>
  <div class="sbc-sessions">
    {
      groups.map(({ group, label, entries, count, hidden }) => (
        <div class="sbc-group" hidden={hidden} data-nav-group={group}>
          <p class="sbc-label">
            <span>{label}</span>
            <b class="nav-count" data-nav-count={group}>
              {count}
            </b>
          </p>
          <ul class="sbc-list" data-nav-list={group}>
            {entries.map((entry) => (
              <NavIcon entry={entry} />
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="sbc-footer">
    <span class="sbc-button large health"><ShieldCheck /></span>
    <span class="sbc-button large"><Settings /></span>
  </div>
</div>
