---
// The window of the desktop app: the macOS window controls, the workspace rail, the sidebar, and
// the page in the slot. The desktop app draws the window controls over the workspace rail. A
// window without a sidebar shows no workspace rail either, as a cropped window does.
import type { HTMLAttributes } from "astro/types";
import Replica from "../Replica.astro";
import type { NavData } from "./nav";
import Rail from "./Rail.astro";
import Sidebar from "./Sidebar.astro";
import SidebarCollapsed from "./SidebarCollapsed.astro";
import "./AppWindow.css";

/** The sidebar of the window and its session list, which also gives the badges of the rail. */
type Chrome =
  { sidebar: "full" | "collapsed"; nav: NavData; kanban?: boolean } | { sidebar: "none" };

type Props = HTMLAttributes<"div"> & {
  chrome: Chrome;
  /** The window sits in the root of another replica, so it is not a replica root. */
  nested?: boolean;
};
const { chrome, nested = false, class: className, ...attributes } = Astro.props;
const Root = nested ? "div" : Replica;
---

<Root class:list={["app-window", className]} data-sidebar={chrome.sidebar} {...attributes}>
  <span class="traffic" aria-hidden="true"><i></i><i></i><i></i></span>
  <div class="app-body">
    {chrome.sidebar !== "none" && <Rail entries={chrome.nav.entries} />}
    {chrome.sidebar === "full" && <Sidebar nav={chrome.nav} kanban={chrome.kanban ?? false} />}
    {
      chrome.sidebar === "collapsed" && (
        <SidebarCollapsed nav={chrome.nav} kanban={chrome.kanban ?? false} />
      )
    }
    <div class="app-main"><slot /></div>
  </div>
  <slot name="overlay" />
</Root>
