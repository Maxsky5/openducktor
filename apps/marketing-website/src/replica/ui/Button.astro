---
// Button of components/ui/button.tsx, with the variants and the sizes that the replicas use. A
// consumer changes the height or the radius with its own class, as the product does with
// `className`. A disabled button has `data-disabled`, and a scene can set it.
import type { HTMLAttributes } from "astro/types";
import "./Button.css";

type Props = HTMLAttributes<"span"> & {
  variant?: "default" | "secondary" | "ghost" | "outline" | "destructive" | "accent";
  size?: "default" | "sm" | "icon";
};
const { variant = "default", size = "default", class: className, ...attributes } = Astro.props;
---

<span class:list={["ui-button", className]} data-variant={variant} data-size={size} {...attributes}
  ><slot /></span
>
