---
// The header of kanban-page-header.tsx: the title, the task card view control, New task, and
// Refresh Tasks. A compact header fits a small board window without a sidebar: it is lower, it
// leaves room for the window controls, and it keeps only New task.
import { Plus, RefreshCw, Rows2, Rows3 } from "@lucide/astro";
import { flag } from "../flag";
import Button from "../ui/Button.astro";
import "./BoardHead.css";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class="board-head" data-compact={flag(compact)}>
  <div class="board-title">Kanban Board</div>
  <div class="board-actions">
    <span class="view-toggle"
      ><span data-active><Rows2 class="i14" /></span><span><Rows3 class="i14" /></span></span
    >
    <Button size="sm" class="board-button"><Plus />New task</Button>
    <Button variant="outline" size="sm" class="board-button board-refresh"
      ><RefreshCw class="i14" />Refresh Tasks</Button
    >
  </div>
</div>
