---
// The Diagnostics sheet of diagnostics-panel.tsx: the title, Refresh, the close button, the
// overview, and the groups in the slot. Refresh is disabled, and its icon spins, while the
// checks run.
import { RefreshCcw, ShieldCheck, X } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import Replica from "../Replica.astro";
import Button from "../ui/Button.astro";
import DiagOverview from "./DiagOverview.astro";
import type { DiagOverviewData } from "./model";
import "./DiagnosticsSheet.css";

type Props = HTMLAttributes<"div"> & { overview: DiagOverviewData };
const { overview, class: className, ...attributes } = Astro.props;
---

<Replica class:list={["diag-sheet", className]} {...attributes}>
  <div class="diag-header">
    <strong><ShieldCheck class="diag-shield" />Diagnostics</strong>
    <Button variant="outline" size="sm" class="diag-refresh" data-refresh
      ><RefreshCcw class="i14" /><span data-refresh-label>Refresh</span></Button
    >
    <span class="diag-close"><X /></span>
  </div>
  <div class="diag-body" data-diag-scroll>
    <DiagOverview {...overview} />
    <slot />
  </div>
</Replica>
