{
  "name": "@openducktor/docs-website",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/prepare-assets.ts && next dev",
    "build": "bun scripts/prepare-assets.ts && next build && bun scripts/finish-export.ts",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --preload ../../tools/bun-test-preload.ts --timeout 1000 ./tests",
    "test:browser": "playwright test",
    "worker:dev": "WRANGLER_SEND_METRICS=false wrangler dev --config wrangler.preview.json --local",
    "worker:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.json && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.preview.json"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@openducktor/build-tools": "workspace:*",
    "@openducktor/product-scenes": "workspace:*",
    "@openducktor/theme": "workspace:*",
    "@xyflow/react": "12.12.0",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "gsap": "^3.15.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "lightningcss": "1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "wrangler": "4.151.1",
    "zod": "^4.6.7"
  }
}
