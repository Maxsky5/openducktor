{
  "name": "@openducktor/docs-website",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/prepare-assets.ts && next dev",
    "build": "bun scripts/prepare-assets.ts && next build && bun scripts/finish-export.ts",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun test --only-failures --timeout 1000",
    "test:browser": "playwright test",
    "worker:dev": "WRANGLER_SEND_METRICS=false wrangler dev --config wrangler.preview.json --local",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.json",
    "worker:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.json && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.preview.json"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@openducktor/build-tools": "workspace:*",
    "@openducktor/product-scenes": "workspace:*",
    "@openducktor/theme": "workspace:*",
    "@xyflow/react": "12.12.0",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "gsap": "^3.15.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "lightningcss": "1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "wrangler": "4.166.0",
    "zod": "^4.6.7"
  }
}
