{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/src/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/src/effect/index.ts"
    },
    {
      "name": "architecture",
      "specifier": "./tools/oxlint/anti-slop/src/architecture/index.ts"
    }
  ],
  "rules": {
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      "files": ["packages/frontend/**/*.ts", "packages/frontend/**/*.tsx"],
      "plugins": ["oxc", "react", "typescript", "unicorn"],
      "rules": {
        "react/exhaustive-deps": "warn",
        "react/no-danger": "warn",
        "react/rules-of-hooks": "warn"
      }
    },
    {
      "files": ["packages/frontend-core/**/*.ts", "packages/frontend-core/**/*.tsx"],
      "plugins": ["oxc", "react", "typescript", "unicorn"],
      "rules": {
        "react/exhaustive-deps": "warn",
        "react/rules-of-hooks": "warn"
      }
    },
    {
      "files": ["packages/host/src/**/*.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 500,
            "skipBlankLines": false,
            "skipComments": false
          }
        ],
        "architecture/restricted-file-paths": [
          "error",
          {
            "pattern": "/packages/host/src/(?:application|adapters)/[^/]+\\.ts$",
            "message": "Host application and adapter files must live in named submodules."
          },
          {
            "pattern": "/packages/host/src/.*task-service-[^/]+\\.ts$",
            "message": "Host task files must use domain or action names, not task-service-* migration names."
          },
          {
            "pattern": "/packages/host/src/commands/",
            "message": "Host commands belong under src/interface/commands, not src/commands."
          },
          {
            "pattern": "/packages/host/src/adapters/(?:.*/)?(?:node|in-memory)-[^/]+\\.ts$",
            "message": "Host adapter file names must describe the external boundary, not start with node-* or in-memory-*."
          }
        ]
      }
    },
    {
      "files": ["packages/host/src/**/use-cases/**/*.ts", "packages/host/src/**/*use-case*.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 200,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    },
    {
      "files": [
        "packages/host/src/application/**/*.ts",
        "packages/host/src/domain/**/*.ts",
        "packages/host/src/interface/**/*.ts",
        "packages/host/src/ports/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "Host inner-layer files must not import Node APIs. Use a port."
              },
              {
                "group": ["**/adapters/**", "**/infrastructure/**"],
                "message": "Host inner-layer files must not import adapters or infrastructure. Use a port."
              },
              {
                "group": ["@openducktor/node-support"],
                "message": "Host inner-layer files must not import Node-only support packages. Use a port."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/host/src/**/*.test.ts",
        "packages/host/src/**/*.spec.ts",
        "packages/host/src/**/test-support/**"
      ],
      "rules": {
        "max-lines": "off",
        "no-restricted-imports": "off",
        "architecture/restricted-file-paths": "off"
      }
    },
    {
      "files": ["packages/runtime-orchestration/src/**/*.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 500,
            "skipBlankLines": false,
            "skipComments": false
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "Runtime orchestration stays platform independent. Put Node code in a host driver or port adapter."
              },
              {
                "group": [
                  "@openducktor/host",
                  "@openducktor/host/*",
                  "@openducktor/frontend",
                  "@openducktor/frontend/*",
                  "@openducktor/node-support",
                  "**/adapters/**",
                  "**/infrastructure/**"
                ],
                "message": "Runtime orchestration must not import host, frontend, or adapter code. Add a port instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/runtime-orchestration/src/**/*.test.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/frontend/src/**/*.ts", "packages/frontend/src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@openducktor/electron",
                  "@openducktor/electron/*",
                  "@openducktor/web",
                  "@openducktor/web/*",
                  "**/apps/electron/**",
                  "**/packages/openducktor-web/**"
                ],
                "message": "Shared frontend code must not import shell internals. Use the shell bridge instead."
              },
              {
                "group": ["@openducktor/frontend-core/test-support/*"],
                "message": "Production frontend code must not import frontend core test support."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/frontend/src/**/*.test.ts",
        "packages/frontend/src/**/*.test.tsx",
        "packages/frontend/src/**/*.test-*.ts",
        "packages/frontend/src/**/*.test-*.tsx",
        "packages/frontend/src/**/*-test-*.ts",
        "packages/frontend/src/**/*-test-*.tsx",
        "packages/frontend/src/**/*.fixture.ts",
        "packages/frontend/src/**/*.fixture.tsx",
        "packages/frontend/src/test-utils/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@openducktor/electron",
                  "@openducktor/electron/*",
                  "@openducktor/web",
                  "@openducktor/web/*",
                  "**/apps/electron/**",
                  "**/packages/openducktor-web/**"
                ],
                "message": "Shared frontend code must not import shell internals. Use the shell bridge instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/electron/src/renderer/**"],
      "rules": {
        "architecture/restricted-file-paths": [
          "error",
          {
            "pattern": "/apps/electron/src/renderer/(?!(?:electron-api\\.d|electron-shell-bridge(?:\\.test)?)\\.ts$|main\\.tsx$)",
            "message": "The Electron renderer stays a thin shell. Move shared UI and runtime code to packages/frontend/src."
          }
        ]
      }
    },
    {
      "files": [
        "packages/frontend-core/src/**/*.ts",
        "packages/frontend-core/src/**/*.tsx",
        "packages/frontend-core/expo-compat/**/*.ts"
      ],
      "rules": {
        "architecture/allowed-imports": [
          "error",
          {
            "root": "packages/frontend-core",
            "packages": [
              "@openducktor/contracts",
              "@openducktor/core",
              "@openducktor/frontend-core",
              "@openducktor/host-client",
              "@openducktor/path-support",
              "@tanstack/react-query",
              "react",
              "zod",
              "zustand"
            ],
            "message": "The frontend core runs in Electron, browsers, and React Native. Import only portable packages, or add a platform port."
          }
        ]
      }
    },
    {
      "files": [
        "packages/frontend-core/src/**/*.test.ts",
        "packages/frontend-core/src/**/*.test.tsx",
        "packages/frontend-core/src/**/*.test-*.ts",
        "packages/frontend-core/src/**/*.test-*.tsx",
        "packages/frontend-core/src/**/*-test-*.ts",
        "packages/frontend-core/src/**/test-utils.ts",
        "packages/frontend-core/src/test-support/**"
      ],
      "rules": {
        "architecture/allowed-imports": "off"
      }
    }
  ],
  "options": {
    "maxWarnings": 0
  }
}
